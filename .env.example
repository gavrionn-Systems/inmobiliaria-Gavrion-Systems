# Supabase — copiar a .env.local y completar con los valores del proyecto
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo server (panel admin y scripts) — nunca exponer ni versionar
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Acceso al panel de administración (obligatorio en producción)
# Email del administrador de empresa
ADMIN_EMAIL=admin@ejemplo.com
# Contraseña del administrador. En desarrollo, si se omite, aplica "demo1234".
ADMIN_PASSWORD=change-me
# Acceso opcional de agente
EMPLOYEE_EMAIL=agente@ejemplo.com
EMPLOYEE_PASSWORD=change-me
# Acceso opcional del administrador de plantilla
TEMPLATE_ADMIN_EMAIL=plantilla@ejemplo.com
TEMPLATE_ADMIN_PASSWORD=change-me
# Secreto para firmar la cookie de sesión (HMAC). Generar uno aleatorio, ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-auth-secret-hex

# Ruta secreta de entrada al panel admin (oculta /admin del público).
# Solo minúsculas/números/guiones. Ej.: gav-x7k2m9 → https://tudominio.com/gav-x7k2m9
# /admin responde 404 sin sesión. Cámbiala y NO la compartas ni la pongas en robots.txt.
ADMIN_PANEL_PATH=gav-x7k2m9

# URL pública de la app (sin slash final).
APP_BASE_URL=https://ejemplo.com
NEXT_PUBLIC_SITE_LOCALE=es
NEXT_PUBLIC_SITE_TIMEZONE=UTC

# WhatsApp Cloud API — secretos exclusivos del servidor
# Token que Meta compara en GET /api/webhooks/meta (hub.verify_token)
META_VERIFY_TOKEN=your-meta-verify-token
# App secret; valida X-Hub-Signature-256 en cada POST del webhook
META_APP_SECRET=your-meta-app-secret
# Token de system user (server-only): sync de plantillas y descarga de media a crm-media.
# El envío directo de mensajes requiere una integración específica; no se configura en la plantilla base.
META_WHATSAPP_TOKEN=your-meta-whatsapp-token
# Alias opcional de META_WHATSAPP_TOKEN (lib/integrations/meta-token.ts)
# META_TEMPLATES_TOKEN=your-meta-whatsapp-token
# ID del WABA; Graph API /{waba_id}/message_templates (sync de plantillas)
META_WABA_ID=your-waba-id
# ID del número WhatsApp, si se habilita una integración directa.
META_PHONE_NUMBER_ID=your-phone-number-id

# Protege las tareas internas de sincronización, si se habilitan.
# Vercel Cron envía Authorization: Bearer <CRON_SECRET> si la variable existe.
CRON_SECRET=your-cron-secret
# No se expone al navegador.
